# code.tui
# this is run on the host, it handles get requests, as well as crawling for music

siteInfo = require(katipo.sitePath + "/site.tui")
host = katipo.host

loadSuccess = true

configPath = file.getAbsolutePath(katipo.privateSavePath + "/config.tui")
print("loading config at path:", configPath)

incomingMusicLibraryPath = false
loadedConfig = false

if(katipo.userConfiguration) #this might be too much of an assumption
{
    print("found userConfiguration:", katipo.userConfiguration)
    incomingMusicLibraryPath = katipo.userConfiguration.musicLibraryPath
    incomingMusicLibraryPath = string.replace(incomingMusicLibraryPath, "\\", "\\\\")
}
else
{
    loadedConfig = file.load(configPath)
    print("loadedConfig:", loadedConfig)
}

createAndSaveDefaultConfig = function()
{
    defaultPath = "/set/your/music/library/path/here"

    if(incomingMusicLibraryPath)
    {
        defaultPath = incomingMusicLibraryPath
    }

    configString = "
# Waraki host configuration file
# anything after '#' like this entire line is a comment and is ignored. To change a given setting, you change the value after the '='
# musicDirectoryPath: set this to the directory that contains music files and .m3u playlists. All files can be nested in subdirectories.
musicDirectoryPath = '"

configString += defaultPath

configString += "'\n"

configString += "# doCrawlOnLaunch Will crawl anyway if the cache file is not found, but you can turn off the crawl if you know your music library won't change
doCrawlOnLaunch = true

# recrawlFrequencySeconds Recrawls the library on disk for new music files every x seconds. Set to nil to disable recrawling. The default is to recrawl every 10 minutes
recrawlFrequencySeconds = 10 * 60

# importM3UPlaylists will attempt to import any .m3u files when crawling. Remember to turn this off again, or it will keep importing more copies
importM3UPlaylists = false"

    file.saveData(configPath, configString)
    print("saved config:", configPath)
}


if(!loadedConfig)
{
    createAndSaveDefaultConfig()
    loadedConfig = file.load(configPath)
}

musicDirectoryPath = loadedConfig.musicDirectoryPath #note:accessed by C++
doCrawlOnLaunch = loadedConfig.doCrawlOnLaunch
convertM4AToMP3 = loadedConfig.convertM4AToMP3 #experimental feature used by dave, not really for public use but you could get it working
importM3UPlaylists = loadedConfig.importM3UPlaylists
recrawlFrequencySeconds = loadedConfig.recrawlFrequencySeconds
scanForLyrics = loadedConfig.scanForLyrics #experimental feature

songServerInfosBySongID = {}
directoryTree = {}

loadFilesFromDir = function(dirPath, exportPrependPathOrNil)
{
    files = {}
    contents = file.directoryContents(dirPath)
    for(fileName in contents)
    {
        if(string.subString(fileName, 0, 1) != ".")
        {
            fullPath = dirPath + "/" + fileName
            if(!file.isDirectory(fullPath))
            {
                fileData = file.loadData(fullPath)
                if(fileData)
                {
                    fileNameToUse = fileName
                    if(exportPrependPathOrNil)
                    {
                        fileNameToUse = exportPrependPathOrNil + fileNameToUse
                    }
                    fileDataWrapper = {
                        fileName = fileNameToUse,
                        data = fileData
                    }
                    table.insert(files, fileDataWrapper)
                }
            }
        }
    }
    if(table.count(files) == 0)
    {
        return nil
    }
    return files
}


doCrawl = function()
{
    print("crawling library. This may take some time..")
    libraryCrawler = require(katipo.sitePath + "/libraryCrawler.tui")
    libraryCrawler.convertM4AToMP3 = convertM4AToMP3
    libraryCrawler.importM3UPlaylists = importM3UPlaylists
    libraryCrawler.scanForLyrics = scanForLyrics
    libraryCrawler.runCrawl(musicDirectoryPath)

    if(importM3UPlaylists)
    {
        for(newPlaylist in libraryCrawler.importedPlaylists)
        {
            playlistID = string.sha1(newPlaylist.title)
            playlistID = string.subString(playlistID, 0, 8)

            if(table.count(newPlaylist.songs) > 0)
            {
                saveData = {
                    playlistID = playlistID
                    name = newPlaylist.title
                    songs = newPlaylist.songs
                }
                sharedPlaylists[playlistID] = saveData
            }
        }
        .importM3UPlaylists = false #avoid importing again on re-crawl
    }
    .songServerInfosBySongID = libraryCrawler.songServerInfosBySongID
    .directoryTree = libraryCrawler.directoryTree

    host.setPublicData("directoryTree", directoryTree)
    host.setPublicData("sharedPlaylists", sharedPlaylists)
    host.setPrivateData("songServerInfosBySongID", songServerInfosBySongID)


}


### this function is called when clients query this site
get = function(url, clientData)
{
    print("in get. url:", url, " clientData:", clientData)
    urlSplit = string.split(url, "/")

    if(urlSplit[0] == "savePlaylist")
    {
        print("got savePlaylist:", clientData)

        playlistID = clientData.playlistID
        songs = clientData.songs
        name = clientData.name
        if(!playlistID or !name)
        {
            return {
                status = "error"
                message = "request missing required playlistID, name"
            }
        }

        if(songs and table.count(songs) > 0)
        {
            sharedPlaylists[playlistID] = {
                playlistID = playlistID
                name = name
                songs = songs
            }
        }
        else
        {
            sharedPlaylists[playlistID] = nil
        }

        host.setPublicData("sharedPlaylists", sharedPlaylists)

        return {
            status = "ok"
        }
    }
    else if(table.count(urlSplit) <= 1) #respond to get fileHost/
    {
       return host.get(url, clientData)
    }
    else if(urlSplit[0] == "songs") #waraki/songs/
    {
        songID = urlSplit[1]
        songInfo = songServerInfosBySongID[songID]
        if(songInfo and file.fileExists(songInfo.path))
        {
            print("file exists. sending...")
            return {
                status = "ok"
                songID = songID
                lyricsPageCount = songInfo.lyricsPageCount
                fileName = songInfo.fileName
                filePath = songInfo.path #internally, katipo looks for filePath and will replace this with the contents of the file. todo should probably just send the data here instead
            }
        }
        else
        {
            return {
                status = "error"
                message = "file not found"
            }
        }
    }
    else if(urlSplit[0] == "images") #waraki/images/songID/imageIndex
    {
        print("got image request:", urlSplit)
        if(table.count(urlSplit) >= 3)
        {
            songID = urlSplit[1]
            imageIndex = urlSplit[2]
            songInfo = songServerInfosBySongID[songID]
            if(imageIndex and songInfo and songInfo.lyricsPageCount > imageIndex)
            {
            
                baseFileName = file.removeExtension(songInfo.fileName)
                pngFileName = baseFileName + "-" + imageIndex + ".png"

                pngFilePath = musicDirectoryPath + "/" + pngFileName

                print("pngFilePath:", pngFilePath)
                
                if(file.fileExists(pngFilePath))
                {
                    print("file exists. sending...")
                    return {
                        status = "ok"
                        songID = songID
                        lyricsPageCount = songInfo.lyricsPageCount
                        fileName = pngFileName
                        filePath = pngFilePath #internally, katipo looks for filePath and will replace this with the contents of the file. todo should probably just send the data here instead
                    }
                }
            }
        }
        
        return {
            status = "error"
            message = "file not found"
        }
            
    }

    return {
        status = "error"
        message = "unhandled request"
    }
}

timeAccumulator = 0.0

update = function(dt)
{
    if(recrawlFrequencySeconds)
    {
        timeAccumulator += dt
        if(timeAccumulator > recrawlFrequencySeconds)
        {
            .timeAccumulator = 0.0
            doCrawl()
        }
    }
}


init = function() #called just after katipo.init. The database is now ready to use.
{
    .directoryTree = host.getPublicData("directoryTree")
    .songServerInfosBySongID = host.getPrivateData("songServerInfosBySongID")
    .sharedPlaylists = host.getPublicData("sharedPlaylists")
    if(!sharedPlaylists)
    {
        .sharedPlaylists = {}
    }

    if(katipo.createSecurityBookmarkForDirectory) #this function is not always set, this is only for macos sandbox security
    {
        if(incomingMusicLibraryPath)
        {
            securityBookmark = katipo.createSecurityBookmarkForDirectory(incomingMusicLibraryPath)
            if(securityBookmark and string.length(securityBookmark) > 0)
            {
                host.setPrivateData("b_" + musicDirectoryPath, securityBookmark)
            }
        }
        else
        {
            securityBookmark = host.getPrivateData("b_" + musicDirectoryPath)
            if(securityBookmark)
            {
                result = katipo.resolveSecurityBookmark(securityBookmark)
            }
        }
    }


    if(!file.fileExists(musicDirectoryPath))
    {
        print("ERROR: musicDirectoryPath not found:", musicDirectoryPath, "\nplease edit ", configPath, " and set musicDirectoryPath to a directory containing your music files.")
        loadSuccess = false
        return
    }


    clientSitePath = file.getAbsolutePath(katipo.sitePath + "/clientSite")
    if(!file.fileExists(clientSitePath))
    {
        print("ERROR: missing publicData directory:", clientSitePath)
        loadSuccess = false
        return
    }

    #print("loaded directory tree:", directoryTree)

    if(doCrawlOnLaunch or !directoryTree)
    {
        doCrawl()
    }
}