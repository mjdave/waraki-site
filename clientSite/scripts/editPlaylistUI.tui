    playlistScrollView.removeAllRows()

    noSongsText = scene.getView("noSongsText")

    if(table.count(playlistContent) > 0)
    {
        noSongsText.hidden = true
        itemLayout = scene.playlistSongItem

        compareFunction = function(a,b)
        {
            return a.fileName < b.fileName
        }
        #sortedFiles = {}
        #for(i,songInfo in playlistContent)
        ##{
        #    table.insert(sortedFiles, songInfo)
        #}
        #table.sort(sortedFiles, compareFunction)

        for(i,songInfo in playlistContent)
        {
            itemView = playlistScrollView.addView(itemLayout)
            itemView.fileInfo = songInfo
            titleTextView = itemView.getView("songItemTitle")
            titleTextView.text = songInfo.fileName
            
            #itemView.baseColor = itemView.color

            #playlistScrollView.insertRow(itemView)

            onMainPlaylistItemCreate(itemView, i)

            #table.insert(songItemViews, itemView)
        }
    }
    else
    {
        noSongsText.hidden = false
    }
}

addSongSubtitleText = false

updatePlaylistTitle = function()
{
    addSongSubtitleText.text = playlistTitle
    playlistTitleTextEntry.setText(playlistTitle)
}

show = function(directoryTree, playlistOrNil)
{
    .currentPreviewPlayingItemView = false
    .currentPreviewPlayingFileBrowserItemView = false

    if(playlistOrNil)
    {
        .playlistContent = playlistOrNil.songs
        .playlistAddedSongIDs = {}
        .currentPlaylistID = playlistOrNil.playlistID
        .playlistTitle = playlistOrNil.name

        for(song in playlistContent)
        {
            playlistAddedSongIDs[song.songID] = true
        }

        loadPlaylistContent()
    }
    else
    {
        .playlistTitle = "New Playlist"
        .playlistContent = {}
        .playlistAddedSongIDs = {}
        .currentPlaylistID = false

        loadPlaylistContent()
    }

    toggleDownloadButton = scene.getView("toggleDownloadButton")
    shuffleButton = scene.getView("shuffleButton")

    if(!addSongFileBrowser)
    {
        fileBrowser.onBrowserItemCreate = onBrowserItemCreate
        fileBrowser.onBrowserContentChange = onBrowserContentChange

        editPlaylistBackButton = scene.getView("editPlaylistBackButton")
        editPlaylistAddSongButton = scene.getView("editPlaylistAddSongButton")

        addSongBackButton = scene.getView("addSongBackButton")

        addSongHeader = scene.getView("addSongHeader")
        .addSongFileBrowser = scene.getView("addSongContent")

        .addSongSubtitleText = addSongHeader.getView("addSongSubtitleText")

        fileBrowser.setDirectoryTree(addSongFileBrowser, directoryTree)

        editPlaylistHeader = scene.getView("editPlaylistHeader")
        editPlaylistContent = scene.getView("editPlaylistContent")

        .playlistTitleTextEntry = scene.getView("playlistTitleTextEntry")

        editPlaylistBackButton.click = delegate.backButtonClicked

        editPlaylistAddSongButton.click = function()
        {
            addSongHeader.hidden = false
            addSongFileBrowser.hidden = false

            editPlaylistHeader.hidden = true
            editPlaylistContent.hidden = true
        }

        toggleDownloadButton.click = function()
        {
            disabledKey = "disabled_" + currentPlaylistID
            oldDisabled = database.get(disabledKey)
            newDisabled = !oldDisabled
            database.set(disabledKey, newDisabled)

            if(newDisabled)
            {
                toggleDownloadButton.path = "images/downloadOff.png"
            }
            else
            {
                toggleDownloadButton.path = "images/downloadOn.png"
            }
        }

        shuffleButton.click = function()
        {
            disabledKey = "shuffleDisabled_" + currentPlaylistID
            oldDisabled = database.get(disabledKey)
            newDisabled = !oldDisabled
            database.set(disabledKey, newDisabled)

            if(newDisabled)
            {
                shuffleButton.path = "images/shuffleOff.png"
            }
            else
            {
                shuffleButton.path = "images/shuffleOn.png"
            }

            .shuffleDisabled = newDisabled
            updateReorderButtonsHidden()
        }
        

        addSongBackButton.click = function()
        {
            editPlaylistHeader.hidden = false
            editPlaylistContent.hidden = false

            loadPlaylistContent()
            updateReorderButtonsHidden()

            addSongHeader.hidden = true
            addSongFileBrowser.hidden = true
        }

        textChangeCallback = function(textValue, changesMade){
            if(changesMade and string.length(textValue) > 0 and playlistTitle != textValue)
            {
                .playlistTitle = textValue
                addSongSubtitleText.text = textValue

                saveCurrentPlaylist()
            }
        }

        playlistTitleTextEntry.setOnFinishedEditing(textChangeCallback)

        
    }
    else if(playlistOrNil)
    {
        #fileBrowser.reload() todo
    }

    downloadDisabled = false

    if(currentPlaylistID)
    {
        disabledKey = "disabled_" + currentPlaylistID
        downloadDisabled = database.get(disabledKey)

        shuffleDisabledKey = "shuffleDisabled_" + currentPlaylistID
        .shuffleDisabled = database.get(shuffleDisabledKey)
    }
    
    if(downloadDisabled)
    {
        toggleDownloadButton.path = "images/downloadOff.png"
    }
    else
    {
        toggleDownloadButton.path = "images/downloadOn.png"
    }

    if(shuffleDisabled)
    {
        shuffleButton.path = "images/shuffleOff.png"
    }
    else
    {
        shuffleButton.path = "images/shuffleOn.png"
    }

    updatePlaylistTitle()
    updateReorderButtonsHidden()
}