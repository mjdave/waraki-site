clearAnyCurrentPlayingSelection = function()
{
    if(currentPreviewPlayingItemView)
    {
        backgroundButtonView = currentPreviewPlayingItemView.getView("playlistSongItemBackground")
        backgroundButtonView.setSelected(false)
        .currentPreviewPlayingItemView = false
    }
    if(currentPreviewPlayingFileBrowserItemView)
    {
        .currentPreviewPlayingFileBrowserItemView = false
    }
}

updateReorderButtonsHidden = function()
{
    playlistScrollView = scene.getView("editPlaylistCurrentPlaylistScrollView")
    rowCount = table.count(playlistScrollView.rowInfos)
    for(i=0, i < rowCount, i++)
    {
        rowInfo = playlistScrollView.rowInfos[i]
        itemView = rowInfo.rowView
        moveUpButton = itemView.getView("moveUpButton")
        moveDownButton = itemView.getView("moveDownButton")
        songItemTitle = itemView.getView("songItemTitle")
        if(!shuffleDisabled)
        {
            moveUpButton.hidden = true
            moveDownButton.hidden = true
            songItemTitle.layoutParent = itemView.getView("addButton")
        }
        else
        {
            songItemTitle.layoutParent = moveDownButton
            if(i > 0)
            {
                moveUpButton.hidden = false
            }
            else
            {
                moveUpButton.hidden = true
            }

            if(i < rowCount - 1)
            {
                moveDownButton.hidden = false
            }
            else
            {
                moveDownButton.hidden = true
            }
        }
    }
}

playingSongChanged = function()
{
    .currentPreviewPlayingSongURL = audio.currentTrackPath()
    if(currentPreviewPlayingSongURL and currentPreviewPlayingSongURL != "")
    {
        print("playingSongChanged:", currentPreviewPlayingSongURL)
        if(currentPreviewPlayingItemView)
        {
            backgroundButtonView = currentPreviewPlayingItemView.getView("playlistSongItemBackground")
            backgroundButtonView.setSelected(false)
            .currentPreviewPlayingItemView = false
        }


        playlistScrollView = scene.getView("editPlaylistCurrentPlaylistScrollView")

        for(i=0, i < table.count(playlistScrollView.rowInfos), i++)
        {
            rowInfo = playlistScrollView.rowInfos[i]
            itemView = rowInfo.rowView
            print("itemView:", itemView)
            if(currentPreviewPlayingSongURL == itemView.songFullURL)
            {
                print("found")
                backgroundButtonView = itemView.getView("playlistSongItemBackground")
                backgroundButtonView.setSelected(true)
                .currentPreviewPlayingItemView = itemView
                break
            }
        }
    }
}

#file browser
playFileBrowserPreview = function(fileBrowserItemView)
{
    clearAnyCurrentPlayingSelection()
    .currentPreviewPlayingFileBrowserItemView = fileBrowserItemView

    delegate.playPreview(fileBrowserItemView.fileInfo)
}

#non file browser
playPreview = function(itemView)
{
    clearAnyCurrentPlayingSelection()
    .currentPreviewPlayingItemView = itemView

    backgroundButtonView = currentPreviewPlayingItemView.getView("playlistSongItemBackground")
    backgroundButtonView.setSelected(true)

    delegate.playPreview(itemView.fileInfo)
}

saveCurrentPlaylist = function()
{
    if(currentPlaylistID)
    {
        serverPlaylistInfo = {
            playlistID = currentPlaylistID
            name = playlistTitle
            songs = playlistContent
        }

        delegate.savePlaylist(serverPlaylistInfo)
    }
}

addOrRemoveSongWithoutSavingOrUpdatingUI = function(songInfo, shouldAdd) #warning similar to below, I am in a rush
{
    if(shouldAdd)
    {
        if(!playlistAddedSongIDs[songInfo.songID])
        {
            table.insert(playlistContent, songInfo)
            playlistAddedSongIDs[songInfo.songID] = true

            if(!currentPlaylistID)
            {
                newPlaylistID = string.sha1(playlistTitle + songInfo.songID + math.random()) #todo tui needs a random sha1 function
                newPlaylistID = string.subString(newPlaylistID, 0, 8)
                .currentPlaylistID = newPlaylistID
            }
        }
    }
    else
    {
        if(playlistAddedSongIDs[songInfo.songID])
        {
            playlistAddedSongIDs[songInfo.songID] = nil
            for(i,addedSongInfo in playlistContent)
            {
                if(addedSongInfo.songID == songInfo.songID)
                {
                    table.remove(playlistContent, i)
                    break
                }
            }
        }
    }
}


toggleSongAddedToPlaylist = function(buttonView, songInfo, backgroundView, updateSelectionState)
{
    if(playlistAddedSongIDs[songInfo.songID])
    {
        playlistAddedSongIDs[songInfo.songID] = nil
        for(i,addedSongInfo in playlistContent)
        {
            if(addedSongInfo.songID == songInfo.songID)
            {
                table.remove(playlistContent, i)
                saveCurrentPlaylist()
                break
            }
        }
        buttonView.path = "images/add.png"
        if(updateSelectionState)
        {
            backgroundView.setSelected(false)
        }
    }
    else
    {
        table.insert(playlistContent, songInfo)
        playlistAddedSongIDs[songInfo.songID] = true
        buttonView.path = "images/remove.png"
        if(updateSelectionState)
        {
            backgroundView.setSelected(true)
        }

        if(!currentPlaylistID)
        {
            newPlaylistID = string.sha1(playlistTitle + songInfo.songID + math.random()) #todo tui needs a random sha1 function
            newPlaylistID = string.subString(newPlaylistID, 0, 8)
            .currentPlaylistID = newPlaylistID
        }

        saveCurrentPlaylist()
    }

    updateAddAllButtons(addSongFileBrowser)

    #print("playlistContent:", playlistContent)
}

onBrowserItemCreate = function(itemView, index)
{
    addButtonView = itemView.getView("addButton")
    if(addButtonView) #existance proves this is a file, not a directory we are clicking on
    {
        backgroundView = itemView.getView("fileItemBackground")
        backgroundViewClickFunction = function()
        {
            playFileBrowserPreview(itemView)
        }

        backgroundView.setClickFunction(backgroundViewClickFunction)

        addButtonView.click = function()
        {
            toggleSongAddedToPlaylist(addButtonView, itemView.fileInfo, backgroundView, true)
        }
        addButtonView.setHueOffset(-0.1 * itemView.rowIndex)

        highlight = false
        if(playlistAddedSongIDs[itemView.fileInfo.songID])
        {
            addButtonView.path = "images/remove.png"
            highlight = true
        }

        if(highlight)
        {
            backgroundView.setSelected(true)
        }
    }
    else if(itemView.fileInfo.files)
    {
        checkFiles = function(files)
        {
            for(thisFile in files)
            {
                if(thisFile.songID)
                {
                    if(playlistAddedSongIDs[thisFile.songID])
                    {
                        return true
                    }
                }
                else if(thisFile.files)
                {
                    if(checkFiles(thisFile.files))
                    {
                        return true
                    }
                }
            }
            return false
        }

        foundAddedFile = checkFiles(itemView.fileInfo.files)
        if(foundAddedFile)
        {
            backgroundView = itemView.getView("fileItemBackground")
            backgroundView.setSelected(true)
        }

    }
}


onMainPlaylistItemCreate = function(itemView, index)
{
    backgroundButtonView = itemView.getView("playlistSongItemBackground")
    if(itemView.rowIndex % 2 == 0)
    {
        backgroundButtonView.color = backgroundButtonView.color * 0.5
    }
    backgroundButtonView.baseColor = backgroundButtonView.color

    addButtonView = itemView.getView("addButton")
    if(addButtonView)
    {
        updateVisualsForThisItem = function()
        {
            playlistSongItemDeletionWarningRedBackground = itemView.getView("playlistSongItemDeletionWarningRedBackground")
            if(playlistAddedSongIDs[itemView.fileInfo.songID])
            {
                addButtonView.path = "images/remove.png"
                playlistSongItemDeletionWarningRedBackground.hidden = true
            }
            else
            {
                addButtonView.path = "images/add.png"
                playlistSongItemDeletionWarningRedBackground.hidden = false
            }
        }

        addButtonView.click = function()
        {
            toggleSongAddedToPlaylist(addButtonView, itemView.fileInfo, backgroundButtonView, false)
            updateVisualsForThisItem()
        }
        addButtonView.setHueOffset(-0.1 * itemView.rowIndex)

        moveUpButton = itemView.getView("moveUpButton")
        moveUpButton.click = function()
        {
            prevInfo = playlistContent[itemView.rowIndex]
            table.remove(playlistContent, itemView.rowIndex)
            table.insert(playlistContent, itemView.rowIndex - 1, prevInfo)

            saveCurrentPlaylist()

            playlistScrollView = scene.getView("editPlaylistCurrentPlaylistScrollView")
            playlistScrollView.moveRow(itemView.rowIndex, itemView.rowIndex - 1)
            updateReorderButtonsHidden()
        }
        moveUpButton.setHueOffset(-0.1 * itemView.rowIndex - 0.1)

        moveDownButton = itemView.getView("moveDownButton")
        moveDownButton.click = function()
        {
            prevInfo = playlistContent[itemView.rowIndex]
            table.remove(playlistContent, itemView.rowIndex)
            table.insert(playlistContent, itemView.rowIndex + 1, prevInfo)

            saveCurrentPlaylist()

            playlistScrollView = scene.getView("editPlaylistCurrentPlaylistScrollView")
            playlistScrollView.moveRow(itemView.rowIndex, itemView.rowIndex + 1)
            updateReorderButtonsHidden()
        }
        moveDownButton.setHueOffset(-0.1 * itemView.rowIndex - 0.2)


        backgroundButtonView.click = function()
        {
            playPreview(itemView)
        }

        itemView.songFullURL = delegate.getFullSongPath(itemView.fileInfo.localPath)

        if(currentPreviewPlayingSongURL == itemView.songFullURL)
        {
            backgroundButtonView.setSelected(true)
            .currentPreviewPlayingItemView = itemView
        }

        updateVisualsForThisItem()
    }
}

updateAddAllButtons = function(fileBrowserView)
{
    addAllButton = addSongFileBrowser.getView("addAllButton")

    foundFileToAdd = false
    foundFileToRemove = false

    addFiles = {}
    removeFiles = {}

    if(fileBrowserView.currentFile)
    {
        files = fileBrowserView.currentFile.files
        if(files)
        {
            for(thisFile in files)
            {
                if(thisFile.localPath)
                {
                    if(playlistAddedSongIDs[thisFile.songID])
                    {
                        .foundFileToRemove = true
                        table.insert(removeFiles, thisFile)
                    }
                    else
                    {
                        .foundFileToAdd = true
                        table.insert(addFiles, thisFile)
                    }
                }
            }
        }
    }

    if(foundFileToAdd)
    {
        addAllButton.hidden = false

        addAllClick = function()
        {
            for(fileInfo in addFiles)
            {
                addOrRemoveSongWithoutSavingOrUpdatingUI(fileInfo, true)
            }
            saveCurrentPlaylist()
            fileBrowser.reloadCurrentView(fileBrowserView)
        }

        addAllButton.setClickFunction(addAllClick)
        addAllButton.path = "images/addAll.png"
    }
    else if(foundFileToRemove)
    {
        addAllButton.hidden = false

        removeAllClick = function()
        {
            for(fileInfo in removeFiles)
            {
                addOrRemoveSongWithoutSavingOrUpdatingUI(fileInfo, false)
            }
            saveCurrentPlaylist()
            fileBrowser.reloadCurrentView(fileBrowserView)
        }

        addAllButton.setClickFunction(removeAllClick)
        addAllButton.path = "images/removeAll.png"
    }
    else
    {
        addAllButton.hidden = true
    }
}

onBrowserContentChange = function(fileBrowserView)
{
    .currentPreviewPlayingItemView = false
    .currentPreviewPlayingFileBrowserItemView = false

    updateAddAllButtons(fileBrowserView)
}

