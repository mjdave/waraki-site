#global http
#global katipo

if(!http)
{
    error("Sonos support requires that katipoHost is built with KATIPO_COMPILE_WITH_HTTP_INTERFACE")
    return
}

/*
POST /MediaRenderer/RenderingControl/Control
Host: 192.168.x.x:1400
soapaction: "urn:schemas-upnp-org:service:RenderingControl:1#{ActionName}"
Content-Type: text/xml; charset="utf-8"

<?xml version="1.0" encoding="utf-8"?>
<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
  <s:Body>
    {ActionBodyHere}
  </s:Body>
</s:Envelope>

-----

<u:GetVolume xmlns:u="urn:schemas-upnp-org:service:RenderingControl:1">
<InstanceID>0</InstanceID>
<Channel>Master</Channel>
</u:GetVolume>
header:

Content-Type:text/xml; Charset=UTF-8
    soapaction: urn:schemas-upnp-org:service:RenderingControl:1#GetVolume

body:

<?xml version="1.0" encoding="utf-8"?>
    <s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
      <s:Body>

<u:GetVolume xmlns:u="urn:schemas-upnp-org:service:RenderingControl:1">
<InstanceID>0</InstanceID>
<Channel>Master</Channel>
</u:GetVolume>

    </s:Body>
    </s:Envelope>
url:192.168.0.42:1400/MediaRenderer/RenderingControl/Control

<u:GetVolume xmlns:u="urn:schemas-upnp-org:service:RenderingControl:1">
  <InstanceID>ui4</InstanceID>
  <Channel>string</Channel>
</u:GetVolume>

*/



speakerInfosByName = false
speakerNames = {}

checkInitialized = function()
{
    if(!speakerInfosByName)
    {
        error("sonos.tui not initialized")
        return false
    }
    return true
}

getQuery = function(actionName, extraInfo)
{
    result = "<u:" + actionName + " xmlns:u=\"urn:schemas-upnp-org:service:AVTransport:1\"><InstanceID>0</InstanceID>"
    if(actionName == "GetVolume")
    {
        result = "<u:" + actionName + " xmlns:u=\"urn:schemas-upnp-org:service:RenderingControl:1\">\n<InstanceID>0</InstanceID>\n"
        result += "<Channel>Master</Channel>\n"
    }

    if(actionName == "Play")
    {
        result += "<Speed>1</Speed>\n"
    }
    else if(actionName == "SetAVTransportURI")
    {
        result += "<CurrentURI>x-rincon-queue:" + extraInfo + "#0</CurrentURI>\n"
        result += "<CurrentURIMetaData></CurrentURIMetaData>\n"
        /*<u:SetAVTransportURI xmlns:u="urn:schemas-upnp-org:service:AVTransport:1">
  <InstanceID>ui4</InstanceID>
  <CurrentURI>string</CurrentURI>
  <CurrentURIMetaData>string</CurrentURIMetaData>
</u:SetAVTransportURI>*/
    }
    else if(actionName == "AddURIToQueue")
    {
        result += "<EnqueuedURI>" + extraInfo + "</EnqueuedURI>\n"
        result += "<DesiredFirstTrackNumberEnqueued>0</DesiredFirstTrackNumberEnqueued>\n"
        result += "<EnqueuedURIMetaData></EnqueuedURIMetaData>\n"
        result += "<EnqueueAsNext>1</EnqueueAsNext>\n"
    }
    else if(actionName == "AddMultipleURIsToQueue")
    {

/*
<u:AddMultipleURIsToQueue xmlns:u="urn:schemas-upnp-org:service:AVTransport:1">
  <UpdateID>ui4</UpdateID>
  <NumberOfURIs>ui4</NumberOfURIs>
  <EnqueuedURIs>string</EnqueuedURIs>
  <EnqueuedURIsMetaData>string</EnqueuedURIsMetaData>
  <ContainerURI>string</ContainerURI>
  <ContainerMetaData>string</ContainerMetaData>
  <DesiredFirstTrackNumberEnqueued>ui4</DesiredFirstTrackNumberEnqueued>
  <EnqueueAsNext>boolean</EnqueueAsNext>
</u:AddMultipleURIsToQueue>
*/
        result += "<UpdateID>0</UpdateID>\n"
        result += "<ContainerURI></ContainerURI>\n"
        result += "<ContainerMetaData></ContainerMetaData>\n"
        result += "<NumberOfURIs>" + 1 + "</NumberOfURIs>\n"
        result += "<EnqueuedURIs>" + extraInfo[0] + "</EnqueuedURIs>\n"
        result += "<DesiredFirstTrackNumberEnqueued>0</DesiredFirstTrackNumberEnqueued>\n"
        result += "<EnqueuedURIsMetaData></EnqueuedURIsMetaData>\n"
        result += "<EnqueueAsNext>1</EnqueueAsNext>\n"
    }
    
    result += "</u:" + actionName + ">"
    print("result:", result)
    return result
}

getBody = function(actionName, extraInfo)
{
    query = getQuery(actionName, extraInfo)
    result = "<?xml version=\"1.0\" encoding=\"utf-8\"?>
    <s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\">
      <s:Body>
    " + query + "
    </s:Body>
    </s:Envelope>"
    return result
}

getHeader = function(actionName)
{
    if(actionName == "GetVolume")
    {
        return "Content-Type:text/xml; Charset=\"utf-8\"\r
soapaction: urn:schemas-upnp-org:service:RenderingControl:1#" + actionName + "\r"
    }

    return "Content-Type:text/xml; Charset=\"utf-8\"\r
soapaction: urn:schemas-upnp-org:service:AVTransport:1#" + actionName + "\r"
}

callSonosFunction = function(roomName, actionName, extraInfo, callback)
{
    if(!checkInitialized())
    {
        return
    }

    speakerInfo = speakerInfosByName[roomName]
    if(!speakerInfo)
    {
        error("no speaker named:" + roomName)
    }

    header = getHeader(actionName)
    body = getBody(actionName, extraInfo)

    callbackToUse = callback

    if(!callback)
    {
        callbackToUse = function(result)
        {

        }
    }

    if(actionName == "GetVolume")
    {
        print("header:", header)
        print("body:", body)
        print("url:", speakerInfo.ip + ":1400/MediaRenderer/RenderingControl/Control")
        http.post(speakerInfo.ip + ":1400/MediaRenderer/RenderingControl/Control", header, body, callbackToUse)
    }
    else
    {
        http.post(speakerInfo.ip + ":1400/MediaRenderer/AVTransport/Control", header, body, callbackToUse)
    }
}

urlReplacements = {
 " " = "%20"
 "&" = "%26"
}

htmlEscape = function(inString)
{
    outSting = ""
    charFunction = function(char)
    {
        replacement = urlReplacements[char]
        if(replacement)
        {
            outSting += replacement
        }
        else
        {
            outSting += char
        }
    }
    string.eachChar(inString, charFunction)
    return outSting
}


play = function(roomName, songList)
{
    print("sonos got play for room:", roomName, " songList:", songList)

    #localPath = songList[0].localPath
    #uri = "x-file-cifs%3a%2f%2fblue%2fmusic%2fEagles%2f1976%2520-%2520Their%2520Greatest%2520Hits%25201971-1975%2f02.%2520Witchy%2520Woman.flac"
    #uri = ("x-file-cifs://blue/music/Ann%20Lee/Unknown%20Album/2%20Times.mp3")
    #uris = {uri}
    #getPositionInfo(roomName)
    callSonosFunction(roomName, "SetAVTransportURI", speakerInfosByName[roomName].uuid)
    #sleep(1)
    #sleep(1)
    #callSonosFunction(roomName, "AddURIToQueue", uri)
    #callSonosFunction(roomName, "AddMultipleURIsToQueue", uris)

    shuffled = table.clone(songList)
    table.shuffle(shuffled)

    callSonosFunction(roomName, "RemoveAllTracksFromQueue")
    for(index,song in shuffled)
    {
        sleep(0.01)
        uri = "x-file-cifs://blue/music/" + htmlEscape(song.localPath)
        print("uri:", uri)
        callSonosFunction(roomName, "AddURIToQueue", uri)
        if(index == 0)
        {
            sleep(0.01)
            callSonosFunction(roomName, "Play")
        }
        #break
    }
    
}

pause = function(roomName)
{
    callSonosFunction(roomName, "Pause")
}

getMediaInfo = function(roomName)
{
    callSonosFunction(roomName, "GetMediaInfo")
}

getTransportInfo = function(roomName)
{
    callSonosFunction(roomName, "GetTransportInfo")
}

getMediaInfo = function(roomName)
{
    callSonosFunction(roomName, "GetMediaInfo")
}

getPositionInfo = function(roomName)
{
    callSonosFunction(roomName, "GetPositionInfo")
}

addToVolume = function(roomName, amount)
{
   # callSonosFunction(roomName, "SetAVTransportURI", speakerInfosByName[roomName].uuid)
    getCallback = function(result)
    {
        print("GetVolume got result:" result)
    }
    callSonosFunction(roomName, "GetVolume", nil, getCallback)
}


debugMode = true

findSpeakers = function(subNet)
{
    if(debugMode)
    {
        .speakerNames = katipo.host.getPublicData("sonosSpeakerNames")
        .speakerInfosByName = katipo.host.getPublicData("speakerInfosByName")
        print("speakers:", speakerInfosByName)
        print("speakerNames:", speakerNames)
    }
    else
    {
        .speakerInfosByName = {}
        katipo.host.setPublicData("sonosSpeakerNames", nil)

        for(i = 2, i < 255, i++)
        {
            speakerIP = subNet + i
            callback = function(result)
            {
                roomName = string.findBetween(result, "<roomName>", "</roomName>")
                if(roomName)
                {
                    uuid = string.findBetween(result, "<UDN>uuid:", "</UDN>")
                    print(speakerIP + " found room:" string.lower(roomName), " uuid:", uuid)
                    if(!speakerInfosByName[roomName])
                    {
                        table.insert(speakerNames, roomName)
                    }
                    speakerInfosByName[roomName] = {
                        ip = speakerIP
                        uuid = uuid
                    }

                    katipo.host.setPublicData("sonosSpeakerNames", speakerNames)
                    katipo.host.setPublicData("speakerInfosByName", speakerInfosByName)

                    print("speakerNames:", speakerNames)
                    print("speakerInfosByName:", speakerInfosByName)
                }
            }

            http.get(speakerIP + ":1400/xml/device_description.xml", callback)
        }

    }
    
}