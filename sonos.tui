{
    print("sonos got play for room:", roomName, " songList:", songList)

    #localPath = songList[0].localPath
    #uri = "x-file-cifs%3a%2f%2fblue%2fmusic%2fEagles%2f1976%2520-%2520Their%2520Greatest%2520Hits%25201971-1975%2f02.%2520Witchy%2520Woman.flac"
