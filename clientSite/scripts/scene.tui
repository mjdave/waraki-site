viewTypes = { #can be added to at any time
    button = require("app/common/button.tui")
    textEntry = require("app/common/textEntry.tui")
    scrollView = require("app/common/scrollView.tui")
    fileBrowser = require("app/common/fileBrowser.tui")
    markup = require("app/common/markupView.tui")
}

settingsUI = require("scripts/settingsUI.tui")

topStatusBarHeight = 20
headerHeight = 50
footerHeight = 100
playbackTimelineHeight = 20

statusMainTopHeader = {
    id = "statusMainTopHeader"
    type = "color"
    color = vec4(0.0,0.04,0.06,0.5)
    alignmentX = "left"
    alignmentY = "top"
    pos = vec3(0,-headerHeight,0)
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x, topStatusBarHeight)
    }
    subviews = {
        {
            id = "statusText"
            type = "text"
            text = "Welcome To Waraki"
            color = vec4(0.5,1.0,1.0,0.6)
            font = "roboto"
            additiveBlend = true
            fontSize = 14
        }
        {
            id = "statusDownloadProgress"
            type = "color"
            color = vec4(0.2,0.8,1.0,1.0)
            additiveBlend = true
            alignmentY = "bottom"
            alignmentX = "left"
            hidden = true
        }
    }
}

playbackTimeline = {
    id = "playbackTimeline"
    type = "color"
    color = vec4(0.0,0.04,0.06,0.5)
    alignmentX = "left"
    alignmentY = "bottom"
    pos = vec3(0,footerHeight,0)
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x, playbackTimelineHeight)
    }
    subviews = {
        {
            id = "playbackTimelineStatusText"
            type = "text"
            text = "0:00"
            color = vec4(0.5,1.0,1.0,0.6)
            alignmentX = "right"
            font = "roboto"
            additiveBlend = true
            fontSize = 14
            pos = vec3(-5,0,0)
        }
        {
            id = "playbackTimelineProgress"
            type = "color"
            #shader = "colorViewHueShift"
            color = vec4(0.2,0.5,0.6,0.5)
            additiveBlend = true
            alignmentY = "bottom"
            alignmentX = "left"
            size = vec2(playbackTimelineHeight - 4,playbackTimelineHeight - 4)
            pos = vec3(2,2,0)
            hidden = true
        }
    }
}

playlistsHeader = {
    id = "playlistsHeader"
    type = "color"
    color = vec4(0.0,0.2,0.2,0.2)
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x, headerHeight)
    }
    alignmentX = "left"
    alignmentY = "top"
    subviews = {
        {
            id = "settingsButton"
            type = "button"
            buttonType = "imageHueShift"
            path = "images/settings.png"
            pos = vec3(10,0, 0)
            size = vec2(40,40)
            alignmentX = "left"
        }
        {
            id = "title"
            type = "text"
            text = "Playlists"
            font = "roboto"
            additiveBlend = true
            fontSize = 18
            #pos = vec3(0,10, 0)
        }
        {
            id = "addPlaylistButton"
            type = "button"
            buttonType = "imageHueShift"
            path = "images/add.png"
            pos = vec3(-10,0, 0)
            size = vec2(40,40)
            alignmentX = "right"
        }
    }
}

editPlaylistHeader = {
    id = "editPlaylistHeader"
    type = "color"
    hidden = true
    color = vec4(0.0,0.0,0.2,0.2)
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x, headerHeight)
    }
    alignmentX = "left"
    alignmentY = "top"
    subviews = {
        {
            id = "editPlaylistBackButton"
            type = "button"
            buttonType = "imageHueShift"
            path = "images/back.png"
            pos = vec3(10,0, 0)
            size = vec2(40,40)
            alignmentX = "left"
        }
        {
            id = "playlistTitleTextEntry"
            type = "textEntry"
            font = "roboto"
            fontSize = 18
            backgroundColor = vec4(0.05,0.1,0.2,0.8)
            onParentSizeChanged = function(parentSize)
            {
                return vec2(parentSize.x - 50 - 53 - 50 - 10 - 20, 40)
            }
            pos = vec3(60,0,0)
            alignmentX = "left"
        }
        {
            id = "toggleDownloadButton"
            type = "button"
            buttonType = "imageHueShift"
            path = "images/downloadOn.png"
            pos = vec3(-10 - 40 - 10, 0, 0)
            size = vec2(53,40)
            alignmentX = "right"
        }
        {
            id = "editPlaylistAddSongButton"
            type = "button"
            buttonType = "imageHueShift"
            path = "images/add.png"
            pos = vec3(-10,0, 0)
            size = vec2(40,40)
            alignmentX = "right"
        }
    }
}


addSongHeader = {
    id = "addSongHeader"
    type = "color"
    hidden = true
    color = vec4(0.0,0.2,0.0,0.2)
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x, headerHeight)
    }
    alignmentX = "left"
    alignmentY = "top"
    subviews = {
        {
            id = "addSongBackButton"
            type = "button"
            buttonType = "imageHueShift"
            path = "images/back.png"
            pos = vec3(10,0, 0)
            size = vec2(40,40)
            alignmentX = "left"
        }
        {
            id = "searchButton"
            type = "button"
            buttonType = "imageHueShift"
            path = "images/search.png"
            pos = vec3(10,0, 0)
            size = vec2(40,40)
            alignmentX = "outerRight"
            layoutParentID = "addSongBackButton"
        }
        {
            id = "searchTextEntry"
            type = "textEntry"
            font = "roboto"
            fontSize = 18
            backgroundColor = vec4(0.0,0.2,0.4,0.6)
            size = vec2(120,40)
            pos = vec3(10,0, 0)
            hidden = true
            alignmentX = "outerRight"
            layoutParentID = "searchButton"
        }
        {
            id = "addSongTitleText"
            type = "text"
            text = "Add Songs"
            font = "roboto"
            additiveBlend = true
            fontSize = 18
            pos = vec3(0,10, 0)
        }
        {
            id = "addSongSubtitleText"
            type = "text"
            text = "Add Songs"
            font = "roboto"
            additiveBlend = true
            fontSize = 16
            alignmentY = "below"
            layoutParentID = "addSongTitleText"
        }
    }
}

playlistContent = {
    id = "playlistContent"
    type = "view"
    subviews = {
        {
            id = "noPlaylistsText"
            type = "text"
            text = "Add playlists using the '+' button, top right"
            font = "roboto"
            fontSize = 18
        }
        {
            id = "playlistScrollView"
            type = "scrollView"
        }
    }
}

editPlaylistContent = {
    id = "editPlaylistContent"
    hidden = true
    type = "view"
    subviews = {
        {
            id = "noSongsText"
            type = "text"
            text = "Add songs using the '+' button, top right"
            font = "roboto"
            fontSize = 18
        }
        {
            id = "editPlaylistCurrentPlaylistScrollView"
            type = "scrollView"
        }
    }
}


addSongContent = {
    id = "addSongContent"
    type = "fileBrowser"
    hidden = true
}

mainView = {
    type = "view"
    subviews = {
        statusMainTopHeader
        playlistsHeader
        settingsUI.header
        settingsUI.helpHeader
        editPlaylistHeader
        addSongHeader
        {
            id = "mainContent"
            type = "view"
            alignmentY = "top"
            onParentSizeChanged = function(parentSize)
            {
                return vec2(parentSize.x, parentSize.y - headerHeight - footerHeight - topStatusBarHeight - playbackTimelineHeight)
            }
            pos = vec3(0,1.0 - headerHeight - topStatusBarHeight, 0)
            subviews = {
                playlistContent
                settingsUI.content
                settingsUI.helpContent
                editPlaylistContent
                addSongContent
            }
        }
        playbackTimeline
        {
            id = "footer"
            type = "color"
            color = vec4(0.1,0.5,0.2,0.1)
            onParentSizeChanged = function(parentSize)
            {
                return vec2(parentSize.x,footerHeight)
            }
            alignmentX = "left"
            alignmentY = "bottom"
            subviews = {
                {
                    id = "pitchControls"
                    type = "view"
                    hidden = true
                    subviews = {
                        {
                            id = "pitchDownButton"
                            type = "button"
                            buttonType = "imageHueShift"
                            path = "images/remove.png"
                            pos = vec3(10, -10, 0)
                            size = vec2(40,40)
                            alignmentY = "top"
                            alignmentX = "left"
                        }
                        {
                            id = "pitchUpButton"
                            type = "button"
                            buttonType = "imageHueShift"
                            path = "images/add.png"
                            pos = vec3(55, -10, 0)
                            size = vec2(40,40)
                            alignmentY = "top"
                            alignmentX = "left"
                        }
                        {
                            id = "pitchLevel"
                            type = "text"
                            text = "0"
                            font = "roboto"
                            additiveBlend = true
                            fontSize = 18
                            alignmentY = "top"
                            alignmentX = "left"
                            pos = vec3(100, -20, 0)
                        }
                    }
                }

                

                {
                    id = "playPauseButton"
                    type = "button"
                    buttonType = "imageHueShift"
                    path = "images/play.png"
                    pos = vec3(0, -10, 0)
                    size = vec2(40,40)
                    alignmentY = "top"
                }
                {
                    id = "nextButton"
                    type = "button"
                    buttonType = "imageHueShift"
                    path = "images/next.png"
                    pos = vec3(60, -10, 0)
                    size = vec2(40,40)
                    alignmentY = "top"
                }
                {
                    id = "songTitle"
                    type = "text"
                    text = " "
                    font = "roboto"
                    additiveBlend = true
                    fontSize = 18
                    alignmentY = "below"
                    pos = vec3(0, -5, 0)
                    layoutParentID = "playPauseButton"
                }
                {
                    id = "songArtist"
                    type = "text"
                    text = " "
                    font = "roboto"
                    additiveBlend = true
                    fontSize = 16
                    alignmentY = "below"
                    #pos = vec3(0, -5, 0)
                    layoutParentID = "songTitle"
                }
            }
        }
    }
}

mainPlaylistsPlaylistItem = {
    id = "playlistItem"
    type = "view"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x - 20.0,50)
    }

    subviews = {
        {
            id = "playlistItemBackground"
            type = "button"
            buttonType = "color"
            additiveBlend = true
            color = vec4(0.04,0.12,0.15,0.3)
        }
        {
            id = "dotDotDotButton"
            type = "button"
            clip = true
            buttonType = "imageHueShift"
            path = "images/dotDotDot.png"
            pos = vec3(10,0, 0)
            size = vec2(40,40)
            alignmentX = "left"
        }
        {
            id = "playlistItemTitle"
            type = "text"
            text = "Playlist Title"
            font = "roboto"
            alignmentX = "left"
            additiveBlend = true
            pos = vec3(55,0,0)
            fontSize = 18
        }
    }
}

playlistSongItemHeight = 40
addAndPlayButtonSize = vec2(30,30)

playlistSongItem = {
    id = "playlistSongItem"
    type = "view"
    onParentSizeChanged = function(parentSize)
    {
        return vec2(parentSize.x - 20.0,playlistSongItemHeight)
    }

    subviews = {
        {
            id = "playlistSongItemBackground"
            type = "button"
            buttonType = "color"
            additiveBlend = true
            color = vec4(0.04,0.12,0.15,0.3)
        }
        {
            id = "playlistSongItemDeletionWarningRedBackground"
            type = "color"
            additiveBlend = true
            hidden = true
            masksEvents = false
            color = vec4(0.5,0.0,0.0,0.5)
        }
        {
            id = "songItemTitle"
            type = "text"
            text = "Title"
            font = "roboto"
            alignmentX = "left"
            additiveBlend = true
            pos = vec3(40,0,0)
            fontSize = 16
        }
        {
            id = "addButton"
            type = "button"
            buttonType = "imageHueShift"
            clip = true
            path = "images/add.png"
            pos = vec3(5,0, 0)
            size = addAndPlayButtonSize
            alignmentX = "left"
        }
    }
}